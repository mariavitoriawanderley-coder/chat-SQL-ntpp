# Copie para .env e preencha. O .env nunca vai para o repositório nem para a
# imagem Docker — em produção o Cloud Run injeta estas variáveis.

# ─── Serviço ──────────────────────────────────────────────────────────────
AMBIENTE=local
PORT=8000
LOG_LEVEL=INFO

# Origens do CORS, separadas por vírgula. Em produção o front é servido pelo
# próprio FastAPI e esta lista fica VAZIA. Em dev, o Vite:
ALLOWED_ORIGINS=http://localhost:5173

# ─── Google Cloud ─────────────────────────────────────────────────────────
# Projeto que paga as consultas do BigQuery.
GOOGLE_CLOUD_PROJECT=consultas-consuleg

# Região dos datasets da Base dos Dados. [A CONFIRMAR na Fase 2 — um valor
# errado faz o job falhar com "dataset not found in location".]
BQ_LOCATION=US

# Teto por consulta. 5 GB ≈ US$ 0,03. O BigQuery aborta o job ao ultrapassar.
BQ_MAX_BYTES_BILLED=5000000000
BQ_MAX_ROWS=50000

# ─── Gemini ───────────────────────────────────────────────────────────────
# Em produção: Secret Manager montado como variável de ambiente.
GEMINI_API_KEY=

# ─── Limites de sessão ────────────────────────────────────────────────────
PLAN_CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_SESSION=20
